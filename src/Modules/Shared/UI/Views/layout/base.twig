<!DOCTYPE html>
<html lang="fr">

    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{% block title %}{{ company_title }}{% endblock %}</title> 
        <meta name="description" content="{{ block('meta_description') | trim }}"> 
        <meta name="author" content="Steven Ferlazzo">
        <base href="{{ baseUri|e }}">
        <link rel="canonical" href="{{ canonical }}">       
        <link rel="shortcut icon" href="{{ vite_asset('img/about/logos/favicon-v2.ico') }}">
        <link rel="preload" href="/build/fonts/Inter24pt-Regular.woff2" as="font" type="font/woff2" crossorigin>
        
        {# En développement (watch) #}
        {% if app_debug %}
            <script type="module" src="http://localhost:5173/@vite/client"></script>
            <script type="module" src="http://localhost:5173/src/assets/scss/_main.scss"></script>

            {% if current_page is defined %}
                <script type="module" src="http://localhost:5173/src/assets/scss/pages/{{ current_page_path }}.scss"></script>
            {% endif %}

        {# En production (build) #}
        {% else %}
            {# Applique le CSS #}
            <link rel="stylesheet" href="{{ vite_asset('src/assets/scss/_main.scss') }}">

            {% set pageAsset = vite_asset_optional(current_page ~ '.css') %}
            {% if pageAsset %}
                <link rel="stylesheet" href="{{ pageAsset }}">
            {% endif %}

        {% endif %}

        {% block json_ld %} {% endblock %}

        {% block head %}{% endblock %}
    </head>

    <body data-current-page="{{ current_page|default('default') }}">
        {% include '@Shared/components/header.twig' ignore missing %}

        <main class="{{ current_page }}">
            {% block content %}{% endblock %}
        </main>

        {% include '@Shared/components/footer.twig' ignore missing %}

        {% block javascripts %}
            {# En développement (watch) #}
            {% if app_debug %}
                <script type="module" src="http://localhost:5173/src/assets/js/app.js"></script>
            
            {# En production (build) #}
            {% else %}
                <script type="module" src="{{ vite_asset('app.js') }}"></script>
            {% endif %}
        {% endblock %}
    </body>
</html>
