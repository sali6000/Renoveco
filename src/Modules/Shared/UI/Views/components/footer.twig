<footer data-section="footer">

  <div class="l-split l-split--equal-4 l-split--divided l-split--p-xl l-split--top">

    {# Menu #}
    <div class="l-stack l-stack--gap-l l-stack--p-l c-text--centered">
      <h3>Menu</h3>
      <a href="/">Accueil</a>
      <a href="/about">A propos</a>
      <a href="/contact">Contact</a>
      <a href="/auth/login">Connection</a>
      <a href="/user/register">Inscription</a>
    </div>

    <div class="l-stack l-stack--gap-l l-stack--p-l c-text--centered">
      <h3>Services:</h3>
      <a href="https://localhost/services/panneaux-photovoltaiques">Panneaux photovoltaiques</a>
    </div>

    {# Informations #}
    <div class="l-stack l-stack--gap-l l-stack--p-l c-text--centered">
      <h3>Informations :</h3>
        <span>{{ company_name }}</span>
        <a href="tel:{{ company_phone }}">Tél : {{ company_phone }}</a>
        <a href="mailto:{{ company_mail }}">Mail : {{ company_mail }}</a>
        <span>TVA : {{ company_tva }}</span>
        <span>Addresse: {{ company_address }}</span>
        <a href="cgu">Lire les conditions générales d'utilisation du site (CGU)</a>
    </div>

    {# Réseaux sociaux #}
    <div class="l-stack l-stack--gap-l l-stack--p-l l-stack--align-center">
        <h3>Réseaux sociaux :</h3>
        <div class="l-cluster l-cluster--gap-l">
          <a href="{{ company_facebook }}" class="footer-social__link" title="Suivez-nous sur Facebook" target="_blank" rel="noopener noreferrer">
            <img 
              class="footer-social__icon"
              src="{{ vite_asset('img/layouts/logos/facebook.png') }}" 
              alt="Facebook Renove Construct">
          </a>
          <a href="{{ company_whatsapp }}" class="footer-social__link" title="Contactez-nous sur WhatsApp" target="_blank" rel="noopener noreferrer">
            <img 
              class="footer-social__icon"
              src="{{ vite_asset('img/layouts/logos/whatsapp.png') }}" 
              alt="Facebook Renove Construct">
          </a>
        </div>
      </div>
    </div>
  </div>

  {# Copyright #}
  <div class="l-cluster l-cluster--centered l-cluster--border-top l-cluster--p-xl">
      <p>{{ developper_copyright }}</p>
  </div>

</footer>