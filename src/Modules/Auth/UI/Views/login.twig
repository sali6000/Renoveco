{% extends "@Shared/layout/base.twig" %}

{% block title %}Connexion  - {{ parent() }}{% endblock %}

{% block content %}
<div class="container stack stack--gap-xl stack--p-5xl">
<form class="form" method="post" action="/auth/connection">

    <div class="form__header">
        <h2>Connectez-vous</h2>
        <p>Entrez vos identifiants pour accéder à votre compte</p>
    </div>

    <div class="form__divider"></div>

    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    
    {% if flash_error %}
        <div class="alert alert--danger">{{ flash_error }}</div>
    {% endif %}
    
    <div class="form__field">
        <label class="form__label" for="email-login">Adresse email</label>
        <input
            class="form__input"
            type="email"
            id="email-login"
            name="email"
            autocomplete="username"
            placeholder="Votre email"
            maxlength="30"
            required
            autofocus>
    </div>
    <div class="form__field">
        <label class="form__label" for="password">Mot de passe</label>
        <input
            class="form__input"
            type="password"
            id="password"
            name="password"
            autocomplete="current-password"
            placeholder="Votre mot de passe"
            maxlength="30"
            required>
    </div>
    <button type="submit" class="btn btn--primary">Se connecter</button>
</form>

<div class="form__footer">
    <p>Pas encore de compte ? <a href="/user/register">Inscrivez-vous</a></p>
    <p><a href="/auth/forgot-password">Mot de passe oublié ?</a></p>
</div>
{% endblock %}