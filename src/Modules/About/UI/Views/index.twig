{% extends "@Shared/layout/base.twig" %}

{% block title %}A propos - {{ parent() }}{% endblock %}

{% block content %}
<div class="l-wrapper l-stack l-stack--centered l-stack--gap-2xl l-stack--p-xl">
  <div class="c-image c-image--w-l a-reveal a-reveal--slide-down">
    <img loading="lazy" src="{{ vite_asset('img/about/logos/rclogo-02-dark.png') }}" alt="logo-author">
  </div>
  <div class="l-split l-split--top l-split--equal-2 l-split--gap-xl a-reveal a-reveal--slide-up">

    {# Image #}
    <div class="l-stack l-stack--centered">
        <div class="c-image c-image--w-l">
            <img loading="lazy" 
                src="{{ vite_asset('img/home/renoveconstructlittle.avif') }}" 
                alt="Renove Construct équipe">
        </div>
    </div>

    {# Texte #}
    <div class="l-stack l-stack--gap-l l-stack--align-start">

        {# Accroche mis en valeur #}
        <div class="about-highlight">
            <p>Depuis <strong>plus de 37 ans</strong>, Renove Construct accompagne particuliers et professionnels en Belgique dans leurs projets de construction et de rénovation.</p>
        </div>

        <p>Spécialisés dans la fabrication et la pose de châssis sur mesure, l'installation de vitrages double et triple performance ainsi que dans les solutions photovoltaïques, nous mettons notre expertise au service de la qualité et de la durabilité.</p>

        <p>Notre priorité est simple : proposer des solutions fiables, esthétiques et performantes sur le long terme. Chaque projet est étudié avec rigueur afin de garantir une isolation optimale, une sécurité renforcée et une intégration harmonieuse à votre bâtiment.</p>

        <p>Nous travaillons avec des matériaux certifiés et des techniques éprouvées, en respectant les normes belges en vigueur. Notre équipe assure un accompagnement personnalisé, du premier conseil jusqu'à la finalisation du chantier.</p>

    </div>
  </div>

<div class="l-stack l-stack--gap-xl l-stack--centered a-reveal a-reveal--slide-up">

    <h2>Découvrez notre savoir-faire en vidéo</h2>
    <p>Nos réalisations en fenêtres, châssis et panneaux photovoltaïques</p>

    {# Deux vidéos côte à côte #}
    <div class="l-split l-split--equal-2 l-split--gap-l">
        <div class="c-video c-video--ratio-16-9">
            <video controls preload="none" poster="{{ vite_asset('img/about/poster1.avif') }}">
                <source src="{{ vite_asset('webm/about/video1.webm') }}" type="video/webm">
            </video>
        </div>
        <div class="c-video c-video--ratio-16-9">
            <video controls preload="none" poster="{{ vite_asset('img/about/poster2.avif') }}">
                <source src="{{ vite_asset('webm/about/video2.webm') }}" type="video/webm">
            </video>
        </div>
    </div>

    {# Troisième vidéo centrée #}
    <div class="about-videos__featured">
        <div class="c-video c-video--ratio-16-9">
            <video controls preload="none" poster="{{ vite_asset('img/about/poster3.avif') }}">
                <source src="{{ vite_asset('webm/about/video3.webm') }}" type="video/webm">
            </video>
        </div>
    </div>
</div>

{# Map #}
<h2>Notre localisation</h2>
<span>Addresse: {{ company_address }}</span>
<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2538.001014704153!2d4.230119175848953!3d50.49693887160111!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c236c050039989%3A0x596184a46876f52d!2sRue%20des%20Brasseries%202%2C%207170%20Manage!5e0!3m2!1sfr!2sbe!4v1772579237974!5m2!1sfr!2sbe" width="100%" height="400px" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
{% endblock %}
