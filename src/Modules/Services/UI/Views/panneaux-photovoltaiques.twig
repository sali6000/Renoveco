{% extends "@Shared/layout/base.twig" %}

{% block title %}Installation de Panneaux Photovoltaïques en Belgique – Renove Construct{% endblock %}

{% block meta_description %}Renove Construct installe vos panneaux photovoltaïques en Belgique. Réduisez votre facture d'énergie, valorisez votre bien et bénéficiez des primes régionales. Demandez votre devis gratuit.{% endblock %}

{% block content %}

{# =============================================
   HERO — Image principale + accroche
   ============================================= #}
<section class="pv-hero">
	<div class="pv-hero__media">
		<img
			class="pv-hero__img"
			src="{{ vite_asset('img/services/panneaux-photovoltaiques/image3.jpg') }}"
			alt="Installation de panneaux photovoltaïques réalisée par Renove Construct"
			loading="eager"
			width="1600"
			height="900"
		>
		<div class="pv-hero__overlay"></div>
	</div>
	<div class="pv-hero__content wrapper">
		<span class="pv-hero__eyebrow">Énergie solaire</span>
		<h1 class="pv-hero__title">Panneaux photovoltaïques</h1>
		<p class="pv-hero__subtitle">
			Produisez votre propre électricité, réduisez vos factures et augmentez la valeur de votre bien immobilier.
		</p>
		<a href="/contact" class="btn btn--primary">Demander un devis gratuit</a>
	</div>
</section>

{# =============================================
   INTRO — Accroche SEO + présentation du service
   ============================================= #}
<section class="wrapper stack stack--centered stack--gap-l stack--pb-l stack--pt-l">
	<div class="stack stack--gap-s stack--centered">
		<h2 class="heading heading--2">Pourquoi passer au solaire avec Renove Construct&nbsp;?</h2>
		<p class="text text--muted text--centered text--max-reading">
			Spécialiste de la rénovation et de la construction en Belgique, Renove Construct vous accompagne de A à Z dans votre projet solaire&nbsp;: étude de faisabilité, démarches administratives, installation certifiée et mise en service. Nos techniciens qualifiés interviennent sur tous types de toitures, que vous soyez propriétaire d'une maison unifamiliale, d'un immeuble ou d'une entreprise.
		</p>
	</div>

	{# Chiffres clés / arguments #}
	<div class="split split--equal-4">
		<div class="stack stack--gap-m stack--align-center">
			<span class="pv-stat__number">−70&nbsp;%</span>
			<h3 class="pv-stat__label">sur votre facture d'électricité</h3>
			<p class="text text--muted text--small">Produisez vous-même l'essentiel de votre consommation quotidienne.</p>
		</div>
		<div class="stack stack--gap-m stack--align-center stack--border-left">
			<span class="pv-stat__number">25&nbsp;ans</span>
			<h3 class="pv-stat__label">de durée de vie garantie</h3>
			<p class="text text--muted text--small">Des panneaux de haute qualité avec garantie fabricant longue durée.</p>
		</div>
		<div class="stack stack--gap-m stack--align-center stack--border-left">
			<span class="pv-stat__number">0&nbsp;€</span>
			<h3 class="pv-stat__label">de frais cachés</h3>
			<p class="text text--muted text--small">Devis transparent, prix fixe, aucune mauvaise surprise à la fin du chantier.</p>
		</div>
		<div class="stack stack--gap-m stack--align-center stack--border-left">
			<span class="pv-stat__number">100&nbsp;%</span>
			<h3 class="pv-stat__label">clé sur porte</h3>
			<p class="text text--muted text--small">De la conception à la mise en service, tout est géré par nos équipes.</p>
		</div>
	</div>
</section>

{# =============================================
   GALERIE — Photos chantier & résultat
   ============================================= #}
<section class="pv-gallery wrapper stack--pb-l">
	<h2 class="pv-gallery__title heading heading--2">Nos réalisations</h2>
	<p class="text text--muted text--centered stack--pb-m">Chaque installation est unique&nbsp;: nous adaptons la solution à votre toiture et à vos besoins.</p>

	<div class="pv-gallery__grid">
		{# Photo grande — résultat fini #}
		<div class="pv-gallery__item pv-gallery__item--featured">
			<img
				class="pv-gallery__img"
				src="{{ vite_asset('img/services/panneaux-photovoltaiques/image1.jpg') }}"
				alt="Résultat final d'une installation photovoltaïque par Renove Construct"
				loading="lazy"
				width="800"
				height="600"
			>
			<span class="pv-gallery__caption">Résultat fini</span>
		</div>

		{# Photos secondaires #}
		<div class="pv-gallery__item">
			<img
				class="pv-gallery__img"
				src="{{ vite_asset('img/services/panneaux-photovoltaiques/image2.jpg') }}"
				alt="Chantier d'installation de panneaux solaires"
				loading="lazy"
				width="600"
				height="450"
			>
			<span class="pv-gallery__caption">En cours de pose</span>
		</div>
		<div class="pv-gallery__item">
			<img
				class="pv-gallery__img"
				src="{{ vite_asset('img/services/panneaux-photovoltaiques/image3.jpg') }}"
				alt="Fixation des panneaux photovoltaïques sur toiture"
				loading="lazy"
				width="600"
				height="450"
			>
			<span class="pv-gallery__caption">Fixation sur toiture</span>
		</div>
		<div class="pv-gallery__item">
			<img
				class="pv-gallery__img"
				src="{{ vite_asset('img/services/panneaux-photovoltaiques/image4.jpg') }}"
				alt="Installation photovoltaïque terminée vue de loin"
				loading="lazy"
				width="600"
				height="450"
			>
			<span class="pv-gallery__caption">Vue d'ensemble</span>
		</div>
		<div class="pv-gallery__item">
			<img
				class="pv-gallery__img"
				src="{{ vite_asset('img/services/panneaux-photovoltaiques/image5.jpg') }}"
				alt="Détail du câblage et onduleur photovoltaïque"
				loading="lazy"
				width="600"
				height="450"
			>
			<span class="pv-gallery__caption">Câblage &amp; onduleur</span>
		</div>
	</div>
</section>

{# =============================================
   PROCESSUS — Étapes d'installation
   ============================================= #}
<section class="pv-process stack--pb-l stack--pt-l">
	<div class="wrapper stack stack--gap-l stack--centered">
		<h2 class="heading heading--2">Comment ça se passe&nbsp;?</h2>
		<p class="text text--muted text--centered text--max-reading">
			Un projet solaire réussi repose sur une méthode rigoureuse. Voici comment nous travaillons.
		</p>

		<ol class="pv-process__list">
			<li class="pv-process__item">
				<span class="pv-process__number" aria-hidden="true">01</span>
				<div class="pv-process__body">
					<h3 class="pv-process__step-title">Visite technique &amp; devis</h3>
					<p class="text text--muted">Nous analysons votre toiture, votre consommation électrique et vos attentes. Vous recevez un devis détaillé, gratuit et sans engagement.</p>
				</div>
			</li>
			<li class="pv-process__item">
				<span class="pv-process__number" aria-hidden="true">02</span>
				<div class="pv-process__body">
					<h3 class="pv-process__step-title">Démarches administratives</h3>
					<p class="text text--muted">Nous nous occupons de toutes les formalités&nbsp;: demande de raccordement au réseau, déclaration urbanistique si nécessaire, demande de primes régionales.</p>
				</div>
			</li>
			<li class="pv-process__item">
				<span class="pv-process__number" aria-hidden="true">03</span>
				<div class="pv-process__body">
					<h3 class="pv-process__step-title">Installation par nos techniciens</h3>
					<p class="text text--muted">Nos installateurs certifiés posent les panneaux, l'onduleur et réalisent le câblage dans les règles de l'art, en respectant votre toiture et votre quotidien.</p>
				</div>
			</li>
			<li class="pv-process__item">
				<span class="pv-process__number" aria-hidden="true">04</span>
				<div class="pv-process__body">
					<h3 class="pv-process__step-title">Mise en service &amp; suivi</h3>
					<p class="text text--muted">Raccordement au réseau, mise en service de votre installation et explication du monitoring de production. Vous êtes autonome dès le premier jour.</p>
				</div>
			</li>
		</ol>
	</div>
</section>

{# =============================================
   AVANTAGES — Bloc texte + image côte à côte
   ============================================= #}
<section class="wrapper stack--pb-l">
	<div class="pv-advantages">
		<div class="pv-advantages__media">
			<img
				class="pv-advantages__img image image--w-l"
				src="{{ vite_asset('img/services/panneaux-photovoltaiques/image2.jpg') }}"
				alt="Technicien Renove Construct lors de la pose de panneaux solaires"
				loading="lazy"
				width="700"
				height="520"
			>
		</div>
		<div class="pv-advantages__content stack stack--gap-m">
			<h2 class="heading heading--2">Les avantages de l'énergie solaire</h2>
			<ul class="pv-advantages__list">
				<li class="pv-advantages__list-item">
					<span class="pv-advantages__icon" aria-hidden="true">☀️</span>
					<span><strong>Indépendance énergétique</strong>&nbsp;— produisez votre propre électricité et réduisez votre dépendance aux fournisseurs.</span>
				</li>
				<li class="pv-advantages__list-item">
					<span class="pv-advantages__icon" aria-hidden="true">💶</span>
					<span><strong>Économies immédiates</strong>&nbsp;— amortissement rapide grâce aux primes wallonnes et aux économies sur la facture.</span>
				</li>
				<li class="pv-advantages__list-item">
					<span class="pv-advantages__icon" aria-hidden="true">🏠</span>
					<span><strong>Plus-value immobilière</strong>&nbsp;— une installation photovoltaïque augmente la valeur PEB et l'attractivité de votre bien.</span>
				</li>
				<li class="pv-advantages__list-item">
					<span class="pv-advantages__icon" aria-hidden="true">🌱</span>
					<span><strong>Énergie 100&nbsp;% verte</strong>&nbsp;— réduisez votre empreinte carbone et contribuez à la transition énergétique.</span>
				</li>
				<li class="pv-advantages__list-item">
					<span class="pv-advantages__icon" aria-hidden="true">🔧</span>
					<span><strong>Maintenance quasi nulle</strong>&nbsp;— les panneaux modernes sont robustes et nécessitent très peu d'entretien.</span>
				</li>
			</ul>
		</div>
	</div>
</section>

{# =============================================
   FAQ — Questions fréquentes (SEO longue traîne)
   ============================================= #}
<section class="pv-faq stack--pb-l stack--pt-l">
	<div class="wrapper stack stack--gap-l stack--centered">
		<h2 class="heading heading--2">Questions fréquentes</h2>

		<div class="pv-faq__list">
			<details class="pv-faq__item">
				<summary class="pv-faq__question">Combien coûte une installation photovoltaïque en Belgique&nbsp;?</summary>
				<div class="pv-faq__answer">
					<p>Le prix dépend de la puissance installée (nombre de panneaux), du type de toiture et des équipements choisis (onduleur, batterie de stockage…). Pour obtenir une estimation précise et personnalisée, nous vous invitons à demander un devis gratuit. Nos tarifs sont transparents et tout est inclus&nbsp;: matériel, pose et démarches administratives.</p>
				</div>
			</details>

			<details class="pv-faq__item">
				<summary class="pv-faq__question">Y a-t-il des primes pour les panneaux solaires en Wallonie&nbsp;?</summary>
				<div class="pv-faq__answer">
					<p>Oui. En Région wallonne, plusieurs aides existent&nbsp;: le certificat vert, la prime énergie et les conditions avantageuses du prêt vert. Renove Construct vous guide dans les démarches pour maximiser les aides auxquelles vous avez droit.</p>
				</div>
			</details>

			<details class="pv-faq__item">
				<summary class="pv-faq__question">Mon toit est-il compatible avec des panneaux solaires&nbsp;?</summary>
				<div class="pv-faq__answer">
					<p>La grande majorité des toitures sont compatibles&nbsp;: tuiles, ardoises, tôles, toits plats… Lors de notre visite technique gratuite, nous évaluons l'orientation, l'inclinaison, l'ombrage et la structure portante pour vous proposer la solution optimale.</p>
				</div>
			</details>

			<details class="pv-faq__item">
				<summary class="pv-faq__question">Combien de temps dure une installation&nbsp;?</summary>
				<div class="pv-faq__answer">
					<p>Pour une maison unifamiliale, la pose prend généralement 1 à 2 jours. Les travaux sont peu invasifs et réalisés par nos techniciens certifiés, dans le respect de votre toiture et de votre quotidien.</p>
				</div>
			</details>

			<details class="pv-faq__item">
				<summary class="pv-faq__question">Dois-je entretenir mes panneaux photovoltaïques&nbsp;?</summary>
				<div class="pv-faq__answer">
					<p>L'entretien est minimal&nbsp;: un nettoyage occasionnel et une vérification annuelle suffisent. Les panneaux modernes sont conçus pour résister aux intempéries et leur durée de vie dépasse 25 ans.</p>
				</div>
			</details>
		</div>
	</div>
</section>

{# =============================================
   CTA — Demande de devis
   ============================================= #}
<section id="devis" class="pv-cta">
	<div class="wrapper stack stack--gap-m stack--centered">
		<h2 class="pv-cta__title heading heading--2">Prêt à passer au solaire&nbsp;?</h2>
		<p class="pv-cta__text text text--centered text--max-reading">
			Contactez-nous pour une visite technique gratuite et un devis personnalisé. Nos experts répondent à toutes vos questions et vous accompagnent de la première étape jusqu'à la mise en service.
		</p>
		<a href="/contact" class="btn btn--primary btn--lg">Demander mon devis gratuit</a>
		<p class="text text--muted text--small text--centered">Sans engagement · Réponse sous 48h · Gratuit</p>
	</div>
</section>

{# =============================================
   SCHEMA.ORG — SEO structuré
   ============================================= #}
<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "Service",
	"name": "Installation de panneaux photovoltaïques",
	"description": "Renove Construct installe vos panneaux photovoltaïques en Belgique. Étude, démarches administratives, pose et mise en service clé sur porte.",
	"provider": {
		"@type": "LocalBusiness",
		"name": "Renove Construct",
		"areaServed": {
			"@type": "Country",
			"name": "Belgique"
		}
	},
	"serviceType": "Installation photovoltaïque",
	"areaServed": "Belgique"
}
</script>

{% endblock %}



