{% extends "@Shared/layout/base.twig" %}

{% block title %}Liste des produits - {{ parent() }}{% endblock %}

{% block meta_description %}
Product list meta description
{% endblock %}

{% block content %}

  {# Overlay #}
  <div class="c-filter-overlay" id="filterOverlay" hidden></div>

<div class="l-split l-split--1x4 l-split--top l-split--gap-m">

  {# Filter panel — ajoute l'id et le bouton de fermeture #}
  <aside class="c-filter-panel" id="filterPanel">
    <div class="c-filter-panel__header">
        <button class="c-filter-panel__close" id="filterClose" aria-label="Fermer les filtres">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>
    </div>
    <h2 class="c-filter-panel__title">Filtres</h2>
    <div class="c-filter-panel__group">
      <h3 class="c-filter-panel__group-title">Catégories</h3>
      {% macro categoryItem(category) %}
    <li class="c-filter-panel__item">
        <input class="c-filter-panel__checkbox"
            type="checkbox"
            name="category"
            value="{{ category.name ?? '' }}"
        >
        <label class="c-filter-panel__label">
            {{ category.name ?? '' }}
        </label>
    </li>
    
        {% if category.childrens is not empty %}
            <ul class="c-filter-panel__list c-filter-panel__list--nested">
                {% for child in category.childrens %}
                    {{ _self.categoryItem(child) }}
                {% endfor %}
            </ul>
        {% endif %}
{% endmacro %}

<ul class="c-filter-panel__list c-filter-panel__list--nested" role="list">
    {% for category in categories %}
        {{ _self.categoryItem(category) }}
    {% endfor %}
</ul>
    </div>
    <div class="c-filter-panel__group">
        <h3 class="c-filter-panel__group-title">Contenu</h3>
        <ul class="c-filter-panel__list" role="list">
            <li class="c-filter-panel__item">
                <input class="c-filter-panel__checkbox" type="checkbox" id="brand-xxx" name="brand" value="XXX">
                <label class="c-filter-panel__label" for="brand-xxx">XXX</label>
            </li>
            <li class="c-filter-panel__item">
                <input class="c-filter-panel__checkbox" type="checkbox" id="brand-procural" name="brand" value="procural">
                <label class="c-filter-panel__label" for="brand-procural">Procural</label>
            </li>
        </ul>
    </div>
    <div class="c-filter-panel__group">
      <h3 class="c-filter-panel__group-title">Prix</h3>
      <ul class="c-filter-panel__list" role="list">
        <li class="c-filter-panel__item">
          <input class="c-filter-panel__radio" type="radio" id="price-all" name="price" value="" checked>
          <label class="c-filter-panel__label" for="price-all">Tous</label>
        </li>
        <li class="c-filter-panel__item">
            <input class="c-filter-panel__radio" type="radio" id="price-1" name="price" value="0-100">
            <label class="c-filter-panel__label" for="price-1">0 — 100€</label>
        </li>
        <li class="c-filter-panel__item">
            <input class="c-filter-panel__radio" type="radio" id="price-2" name="price" value="100-300">
            <label class="c-filter-panel__label" for="price-2">100 — 300€</label>
        </li>
        <li class="c-filter-panel__item">
            <input class="c-filter-panel__radio" type="radio" id="price-3" name="price" value="300-9999">
            <label class="c-filter-panel__label" for="price-3">300€+</label>
        </li>
      </ul>
    </div>
  </aside>

  {# Products section#}
  <div class="l-stack l-stack--gap-m l-stack--centered l-stack--p-m">
    
    {# Info section#}
    <section class="l-stack l-stack--p-s l-stack--gap-m">
      <h1 class="c-text--l">
        Menuiserie aluminium — Fenêtres, portes et façades sur mesure
      </h1>
      <p>
        Découvrez notre large gamme de produits en aluminium, adaptés à tous vos besoins en construction et rénovation.
        Que vous recherchiez des fenêtres, des portes, des façades ou des solutions sur mesure, nous avons ce qu'il vous faut.
        Parcourez notre catalogue pour trouver les produits qui allient qualité, durabilité et design moderne.
      </p>
    </section>
    
    {# Searchbar section (and filter mobile version) #}
    <div class="l-cluster l-cluster--gap-m l-cluster--centered">

      {# Filtre version Mobile #}
      <button class="c-filter-trigger" id="filterTrigger" aria-expanded="false" aria-controls="filterPanel">
        <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="6" x2="20" y2="6"/>
            <line x1="8" y1="12" x2="16" y2="12"/>
            <line x1="11" y1="18" x2="13" y2="18"/>
        </svg>
      </button>

      {# Searchbar #}
      <input type="text" id="searchInput" class="c-input" placeholder="PF152WG, PE50, PE78N,..." autofocus>
      <label for="searchInput">
        <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </label>
    </div>

    {# Products card#}
    <ul class="l-grid l-grid--size-m l-grid--gap-m" role="list">
      {% for product in products %}
        <li 
        data-category="{{ product.categories[0].name ?? '' }}"
        data-brand="XXX"
        data-price="120"
        data-search="{{ product.name ?? '' }} {{ product.reference ?? '' }}">
          <article class="c-product-card">
            <a class="c-product-card__link" href="/product/detail/{{ product.slug }}">
              <div class="c-product-card__media">
                <img class="c-product-card__img a-reveal a-reveal--slide-up"
                loading="lazy"
                src="/uploads/img/products/medium/{{ product.images[0].filePath ?? 'placeholder.jpg' }}"
                alt="{{ product.name }} - {{ product.categories[0].name ?? '' }}">
              </div>

              {% if product.supplier_name %}
                <p class="c-product-card__supplier">Fourni par <strong>PROCURAL</strong></p>
              {% endif %}
            </a>

            <div class="c-product-card__body">
              <span class="c-product-card__category">{{ product.categories[0].name ?? '' }}</span>
              <h3 class="c-product-card__title">{{ product.name }}</h3>
              <dl class="c-product-card__specs">
                <dt>Type</dt>
                <dd>{{ product.categories[0].name ?? '' }}</dd>
                <dt>Provenance</dt>
                <dd>{{ product.isProcural ? 'PROCURAL' : 'XXX' }}</dd>
              </dl>
            </div>
          </article>
        </li>
      {% endfor %}
    </ul>
    <p id="searchResults" class="c-no-results" hidden>Aucun produit trouvé</p>
  </div>
</div>

<script type="application/ld+json">{{ jsonLd|raw }}</script>
{% endblock %}
