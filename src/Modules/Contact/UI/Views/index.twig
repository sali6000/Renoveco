{% extends "@Shared/layout/base.twig" %}

{% block title %}Contact - {{ parent() }}{% endblock %}

{% block content %}
<div class="l-stack l-stack--gap-xl l-stack--p-xl">
<form class="c-form" action="contact/mailSend" name="uploadpdf" method="post" enctype="multipart/form-data">
    <div class="c-form__header">
        <h2>Contactez-nous</h2>
        <p>Remplissez le formulaire ci-dessous pour nous envoyer un message. Nous vous répondrons dans les plus brefs délais.</p>
    </div>

    <div class="c-form__divider"></div>

    <input type="hidden" class="csrf_token" value="{{ csrf_token }}">
    <div id="form-error" class="alert alert--danger" style="display:
  none;"></div>
    <div id="form-success" class="alert alert--success" style="display: none;"></div>

    <div class="c-form__field">
        <label class="c-form__label" for="firstname">Nom:</label>
        <input
            class="c-form__input"
            type="text"
            id="firstname"
            name="firstname"
            maxlength="10"
            placeholder="Nom"
        >
    </div>

    <div class="c-form__field">
        <label class="c-form__label" for="lastname">Prénom:</label>
        <input
            class="c-form__input"
            type="text"
            id="lastname"
            name="lastname"
            maxlength="10"
            placeholder="Prénom"
        >
    </div>

    <div class="c-form__field">
        <label class="c-form__label" for="company">Société:</label>
        <input
            class="c-form__input"
            type="text"
            id="company"
            name="company"
            maxlength="10"
            placeholder="Entreprise"
        >
    </div>

    <div class="c-form__field">
        <label class="c-form__label" for="email">* Adresse e-mail:</label>
        <input
            class="c-form__input"
            type="email"
            id="email"
            name="email"
            placeholder="Email"
            required
        >
    </div>

    <div class="c-form__field">
        <label class="c-form__label" for="message">Communication (300 caractères max):</label>
        <textarea
            style="resize:none;"
            id="message"
            name="message"
            placeholder="Votre message..."
            maxlength="300"
            rows="4"
            cols="50"
        ></textarea>
    </div>

    <h5 style="color:red;">Les champs marqués d'un astérisque (*) doivent obligatoirement être remplis.</h5>

    <button type="submit" class="c-btn c-btn--primary">Envoyer</button>
</form>
{% endblock %}
