{% extends "@Shared/layout/base.twig" %}

{% block title %}
Châssis, Fenêtres & Panneaux Solaires en Belgique | Renove Construct
{% endblock %}

{% block meta_description %}
Renove Construct, entreprise de rénovation basée à Manage (Hainaut). Pose de châssis PVC et aluminium, double et triple vitrage, panneaux photovoltaïques. Devis gratuit – intervention dans toute la Belgique.
{% endblock %}

{% block content %}

{# Hero #}
<section data-section="home-hero">

  {# Hero : Carrousel #}
  <div class="home-hero-background home-hero-background--video">
    <video 
      id="hero-video" 
      autoplay muted loop playsinline preload="none"
      poster="{{ vite_asset('img/layouts/background.avif') }}"
      data-src="{{ vite_asset('webm/home/videoloop3.webm') }}"
      data-type="video/webm">
    </video>
  </div>

  {# Hero : Image (Background mobile) #}
  <div class="home-hero-background home-hero-background--mobile">
    <img 
        loading="eager"
        src="{{ vite_asset('img/home/background-mobile.avif') }}"
        alt="Pose de châssis et panneaux photovoltaïques en Belgique – Renove Construct">
  </div>

  {# Hero : Contenu #}
  <div class="home-hero-content wrapper l-stack l-stack--centered">
      <img class="home-hero-logo"
          loading="lazy"
          src="{{ vite_asset('img/about/logos/rclogo-02-light.png') }}"
          alt="Renove Construct – Châssis et panneaux solaires, Manage">

    {# Contenu : Texte #}
    <div class="l-stack l-stack--centered l-stack--gap-2xl">
        <h1 class="home-hero-title a-reveal a-reveal--slide-up">
        Pose de <b>châssis et panneaux photovoltaïques</b> en Belgique
        </h1>
        <h2 class="home-hero-subtitle a-reveal a-reveal--slide-up">
        Entreprise familiale basée à <b>Manage (Hainaut)</b> – Devis gratuit sous 48h
        </h2>
        <p class="home-hero-description a-reveal a-reveal--slide-up">
        Spécialiste en remplacement de fenêtres PVC et aluminium, double et triple vitrage, 
        et installation de panneaux solaires depuis 1989.
        </p>
    </div>

    {# Contenu : Boutons de contact #}
    <div class="home-hero-contact l-cluster l-cluster--gap-xl">

      {# Bouton contact : Contact #}
      <a href="/contact" class="c-btn c-btn--primary" title="Demander un devis gratuit">
      Demandez votre devis gratuit
        <img 
            loading="lazy"
            class="c-btn__icon"
            src="{{ vite_asset('img/layouts/emoticons/direction-right-light.png') }}" 
            alt="">
      </a>

      {# Bouton contact : WhatsApp #}
      <a href="https://wa.me/32492759577" class="c-btn c-btn--whatsapp" title="Contactez-nous sur WhatsApp">
        <img 
            loading="lazy"
            class="c-btn__icon"
            src="{{ vite_asset('img/layouts/emoticons/phone-1.png') }}" 
            alt="">
        WhatsApp
        <img 
            loading="lazy"
            class="c-btn__icon"
            src="{{ vite_asset('img/layouts/emoticons/discussion.png') }}" 
            alt="">
      </a>
    </div>

    {# Contenu : Réseaux sociaux #}
    <div class="home-hero-social l-cluster l-cluster--gap-xl">

    {# Réseaux sociaux : Facebook #}
      <a href="https://www.facebook.com/profile.php?id=61580757421154" class="home-hero-social__link l-cluster l-cluster--gap-s">
        <img 
            loading="lazy"
            class="home-hero-social__icon"
            src="{{ vite_asset('img/layouts/logos/facebook.png') }}" 
             alt="Facebook Renove Construct">
        <span>Facebook</span>
      </a>

      {# Réseaux sociaux : WhatsApp #}
      <a href="tel:+32492759577" class="home-hero-social__link l-cluster l-cluster--gap-s">
        <img 
            loading="lazy"
            class="home-hero-social__icon"
            src="{{ vite_asset('img/layouts/emoticons/phone-1.png') }}" 
            alt="Téléphone Renove Construct">
        <span>+32 492/75.95.77</span>
      </a>
    </div>
  </div>
</section>

{# Présentation #}
<section class="l-wrapper">
  <div class="l-split l-split--2x1 l-split--gap-3xl l-split--p-5xl">
    <div class="l-stack l-stack--centered l-stack--gap-m">
      <div class="c-image home-presentation-logo">
          <img loading="lazy" src="{{ vite_asset('img/about/logos/rclogo-02-dark.png') }}" alt="logo-author">
      </div>
        <h2>
          Votre entreprise de rénovation situé dans le <b>Hainaut</b> depuis 1989
        </h2>
        <p>
          Basée à <strong>Manage</strong>, Renove Construct intervient chez les particuliers et les 
          professionnels pour la <strong>pose de châssis PVC et aluminium</strong>, le 
        <strong>remplacement de vitrages</strong> et l'<strong>installation de panneaux photovoltaïques</strong>.
      </p>
        <p>
          Forts de plus de 35 ans de terrain, nous accompagnons chaque client de la prise de mesures 
        jusqu'à la finition — avec un seul interlocuteur, des délais tenus et un travail soigné.
      </p>
        <p>
        Nous intervenons dans <strong>toute la Belgique</strong>, principalement en 
        <strong>Hainaut, Brabant wallon et région bruxelloise</strong>. 
        Contactez-nous pour un devis gratuit et sans engagement.
      </p>
      </div>
      <div class="c-image c-image--rounded">
        <img loading="lazy" src="{{ vite_asset('img/home/renoveconstructlittle.avif') }}" alt="Équipe Renove Construct – pose châssis et panneaux solaires Manage">
      </div>
  </div>
</section>


{# Services #}
<section data-section="home-services">
  <div class="l-wrapper l-stack l-stack--gap-3xl l-stack--p-xl">

    <div class="l-stack l-stack--centered l-stack--gap-s">
      <h2 class="home-services__title">Nos domaines d'intervention</h2>
      <p class="home-services__intro">
        Châssis, vitrages et énergie solaire — trois métiers maîtrisés par une seule équipe, 
        basée à <strong>Manage</strong>, active dans toute la <strong>Belgique</strong>.
      </p>
    </div>

    <div class="l-split l-split--equal-3 home-services__grid">

      {# Service 1 #}
      <a href="/services/chassis-fenetres" class="home-service-card">
        <div class="home-service-card__image c-image c-image--rounded">
          <img 
            loading="lazy"
            src="{{ vite_asset('img/home/image1.avif') }}"
            alt="Pose de châssis PVC et aluminium – Renove Construct Hainaut">
        </div>
        <div class="home-service-card__body">
          <h3 class="home-service-card__title">Châssis PVC & Aluminium</h3>
          <p class="home-service-card__desc">
            Remplacement et pose de châssis sur mesure — fenêtres, portes-fenêtres et baies vitrées 
            en PVC ou aluminium, adaptés à votre habitation.
          </p>
          <span class="home-service-card__cta">Découvrir ce service →</span>
        </div>
      </a>

      {# Service 2 #}
      <a href="/services/chassis-fenetres" class="home-service-card">
        <div class="home-service-card__image c-image c-image--rounded">
          <img 
            loading="lazy"
            src="{{ vite_asset('img/home/image9.avif') }}"
            alt="Double et triple vitrage – isolation thermique Belgique">
        </div>
        <div class="home-service-card__body">
          <h3 class="home-service-card__title">Double & Triple vitrage</h3>
          <p class="home-service-card__desc">
            Amélioration de l'isolation thermique et acoustique de votre logement grâce au remplacement 
            de vos vitrages existants.
          </p>
          <span class="home-service-card__cta">Découvrir ce service →</span>
        </div>
      </a>

      {# Service 3 #}
      <a href="/services/panneaux-photovoltaiques" class="home-service-card">
        <div class="home-service-card__image c-image c-image--rounded">
          <img 
            loading="lazy"
            src="{{ vite_asset('img/home/image3.avif') }}"
            alt="Installation panneaux photovoltaïques toiture – Belgique">
        </div>
        <div class="home-service-card__body">
          <h3 class="home-service-card__title">Panneaux photovoltaïques</h3>
          <p class="home-service-card__desc">
            Installation de panneaux solaires sur toiture pour produire votre propre électricité 
            et réduire durablement votre facture énergétique.
          </p>
          <span class="home-service-card__cta">Découvrir ce service →</span>
        </div>
      </a>

    </div>
  </div>
</section>

