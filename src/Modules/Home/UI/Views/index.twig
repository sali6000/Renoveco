{% extends "@Shared/layout/base.twig" %}

{% block title %}Renove Construct | Châssis & Panneaux Photovoltaïques en Belgique{% endblock %}

{% block content %}

{# Hero #}
<section data-section="hero">

  {# Hero : Carrousel #}
  <div class="hero-background hero-background--video">
    <video autoplay muted loop playsinline preload="none" poster="{{ encore_asset('img/layouts/background.avif') }}">
      <source src="{{ encore_asset('webm/home/videoloop3.webm') }}" type="video/webm" />
    </video>
  </div>

  {# Hero : Image (Background mobile) #}
  <div class="hero-background hero-background--mobile">
    <img 
        loading="eager"
        src="{{ encore_asset('img/home/background-mobile-light.png') }}"
        alt="Fenêtres et panneaux photovoltaïques en Belgique">
    <div class="hero-logo">
        <img 
            loading="eager"
            src="{{ encore_asset('img/about/logos/rclogo-02-dark.png') }}"
            alt="Logo Renove Construct">
    </div>
  </div>

  {# Hero : Contenu #}
  <div class="container stack stack--gap-5xl stack--centered hero-content">

    {# Contenu : Texte #}
    <div class="stack stack--centered stack--gap-m">
        <h1 class="hero-title reveal slide-up">Entreprise de rénovation en <b>Wallonie</b> - Devis gratuit</h1>
        <h2 class="hero-subtitle reveal slide-up">Pose de <b>fenêtres, panneaux photovoltaïques et isolation</b></h2>
        <p class="hero-description reveal slide-up">Depuis 1989, notre équipe réalise des rénovations complètes pour particuliers et entreprises…</p>
    </div>

    {# Contenu : Boutons de contact #}
    <div class="hero-contact cluster cluster--gap-xl">

      {# Bouton contact : Contact #}
      <a href="/contact" class="btn btn--primary" title="Contact message">Demandez votre devis gratuit
        <img 
            class="btn__icon"
            src="{{ encore_asset('img/layouts/emoticons/direction-right-light.png') }}" 
            alt="">
      </a>

      {# Bouton contact : WhatsApp #}
      <a href="https://wa.me/32492759577" class="btn btn--whatsapp" title="Contact whatsapp">
        <img 
            class="btn__icon"
            src="{{ encore_asset('img/layouts/emoticons/phone-1.png') }}" 
            alt="">
        WhatsApp
        <img 
            class="btn__icon"
            src="{{ encore_asset('img/layouts/emoticons/discussion.png') }}" 
            alt="">
      </a>
    </div>

    {# Contenu : Réseaux sociaux #}
    <div class="hero-social cluster cluster--gap-xl">

    {# Réseaux sociaux : Facebook #}
      <a href="https://www.facebook.com/profile.php?id=61580757421154" class="hero-social__link cluster cluster--gap-s">
        <img 
            class="hero-social__icon"
            src="{{ encore_asset('img/layouts/logos/facebook.png') }}" 
            alt="Facebook Renove Construct Belgique">
        <span>Facebook</span>
      </a>

      {# Réseaux sociaux : WhatsApp #}
      <a href="tel:+32492759577" class="hero-social__link cluster cluster--gap-s">
        <img 
            class="hero-social__icon"
            src="{{ encore_asset('img/layouts/emoticons/phone-1.png') }}" 
            alt="Téléphone Renove Construct Belgique">
        <span>Tél: +32 492/75.95.77</span>
      </a>
    </div>
  </div>
</section>

{# Présentation #}
<section class="container">
  <div class="split split--2x1 split--gap-3xl split--p-5xl">
    <div class="stack stack--centered stack--gap-m">
      <div class="image image--w-s">
          <img src="{{ encore_asset('img/about/logos/rclogo-02-dark.png') }}" alt="logo-author">
      </div>
        <h2>
          Votre partenaire de confiance pour vos projets de rénovation énergétique en Belgique
        </h2>
        <p>
          <strong>Spécialiste en installation de fenêtres et panneaux photovoltaïques</strong>,
          notre entreprise accompagne particuliers et professionnels dans leurs projets de rénovation énergétique.
        </p>
        <p>
          Nous proposons <strong>des solutions sur mesure pour améliorer l'isolation de votre habitation
          et réduire votre consommation d'énergie.</strong> Grâce à notre expertise, nous garantissons
          <strong>des installations durables, conformes aux normes actuelles,
          avec un excellent rapport qualité-prix</strong>.
        </p>
        <p><strong>Nous intervenons dans toute la Belgique, notamment à Bruxelles et en Wallonie</strong>.
          Demandez dès maintenant votre devis gratuit pour vos travaux de fenêtres ou panneaux solaires.
        </p>
      </div>
      <div class="image">
        <img loading="lazy" src="{{ encore_asset('img/home/renoveconstructlittle.avif') }}" alt="entreprise de fenêtres et panneaux photovoltaïques en Belgique">
      </div>
  </div>
</section>

