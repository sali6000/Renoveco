# Configuration applicative — environnement dev (local)

# Database — valeurs correspondantes au docker-compose.yml
DB_CONNECTION=mysql
DB_HOST=mysql           # nom du service Docker
DB_PORT=3306
DB_CHARSET=utf8mb4
DB_NAME=                # doit correspondre à DB_NAME dans .env
DB_USERNAME=            # doit correspondre à DB_USER dans .env
DB_PASSWORD=            # doit correspondre à DB_PASSWORD dans .env

# Mail — recommandé : utiliser Mailtrap (https://mailtrap.io) pour le dev
MAIL_MAILER=smtp
MAIL_HOST=              # ex: sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=          # fourni par Mailtrap
MAIL_PASSWORD=          # fourni par Mailtrap
MAIL_ENCRYPTION=tls